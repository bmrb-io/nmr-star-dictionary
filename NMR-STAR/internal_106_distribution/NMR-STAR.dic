save__Conformer_stat_list.Sf_ID
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Conformer_stat_list.Sf_ID'
   _Item.ID                      4686
   _Item.Name                   '_Conformer_stat_list.Sf_ID'
   _Item.Description
;
An interger value that is the unique identifier for the save frame that 
applies across the archive.  This value is not stable and may be reassigned each 
time the data are loaded into a database system.
;

   _Item.Category_ID                            328
   _Item.Category_label                        '$Conformer_stat_list'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'int'

  loop_
      _Item_linked.Item_name
      _Item_linked.Child_item_ID
      _Item_linked.Child_item_label
      _Item_linked.Child_item_name
      _Item_linked.Child_item_category_ID
      _Item_linked.Child_item_category_label
      _Item_linked.Item_ID
      _Item_linked.Category_ID
      _Item_linked.Dictionary_ID

   ?   ?   ?   ?   ?   ?   ?   ?   ?

  stop_


save_

