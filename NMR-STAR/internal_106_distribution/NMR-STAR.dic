save_Entry_interview
   _Category.Sf_category                category_description
   _Category.Sf_framecode               Entry_interview
   _Category.ID                         1
   _Category.Name                      'Entry_interview'
   _category.Description
;
Items in the entry_interview category capture information from a depositor about the data that is in the entry.
;
   _Category.Mandatory_code             yes
   _Category.Loop_code                  no
   _Category.Category_group_ID          2
   _Category.Category_group_name        entry_interview
   _Category.Dictionary_ID              NMR-STAR

   loop_
     _Category_primary_key.Item_ID
     _Category_primary_key.Item_label
     _Category_primary_key.Item_name
     _Category_primary_key.Category_ID
     _Category_primary_key.Dictionary_ID

    3   '$_Entry_interview.Entry_ID'     '_Entry_interview.Entry_ID'    1   NMR-STAR
    5   '$_Entry_interview.ID'     '_Entry_interview.ID'    1   NMR-STAR

   stop_

save_

save__Entry_interview.Sf_category
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Entry_interview.Sf_category'
   _Item.ID                      1
   _Item.Name                   '_Entry_interview.Sf_category'
   _Item.Description
;
Category definition for the information content of the save frame
;

   _Item.Category_ID                            1
   _Item.Category_label                        '$Entry_interview'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'code'


save_

save__Entry_interview.Sf_framecode
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Entry_interview.Sf_framecode'
   _Item.ID                      2
   _Item.Name                   '_Entry_interview.Sf_framecode'
   _Item.Description
;
A code that uniquely identifies the save frame within the entry.  The code 
can be a human readable identifier that defines the contents of the save frame 
(see the examples).
;

   _Item.Category_ID                            1
   _Item.Category_label                        '$Entry_interview'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'framecode'


save_

