save_Assembly_segment
   _Category.Sf_category                category_description
   _Category.Sf_framecode               Assembly_segment
   _Category.ID                         49
   _Category.Name                      'Assembly_segment'
   _category.Description
;
Items in the assembly_segment category define at levels from atom to chemical component subsets of the assembly. The subsets may be but are not limited to contiguous atoms or components of the assembly. As an example, the active site of a molecular assembly could be defined as a segment.
;
   _Category.Mandatory_code             yes
   _Category.Loop_code                  yes
   _Category.Category_group_ID          9
   _Category.Category_group_name        assembly
   _Category.Dictionary_ID              NMR-STAR

   loop_
     _Category_primary_key.Item_ID
     _Category_primary_key.Item_label
     _Category_primary_key.Item_name
     _Category_primary_key.Category_ID
     _Category_primary_key.Dictionary_ID

    677   '$_Assembly_segment.ID'     '_Assembly_segment.ID'    49   NMR-STAR
    688   '$_Assembly_segment.Entry_ID'     '_Assembly_segment.Entry_ID'    49   NMR-STAR
    689   '$_Assembly_segment.Assembly_ID'     '_Assembly_segment.Assembly_ID'    49   NMR-STAR

   stop_

save_

save__Assembly_segment.ID
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Assembly_segment.ID'
   _Item.ID                      677
   _Item.Name                   '_Assembly_segment.ID'
   _Item.Description
;
Integer value that uniquely defines the segment of the molecular assembly 
described. This tag is not the primary key for this table.
;

   _Item.Category_ID                            49
   _Item.Category_label                        '$Assembly_segment'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'int'

  loop_
      _Item_linked.Item_name
      _Item_linked.Child_item_ID
      _Item_linked.Child_item_label
      _Item_linked.Child_item_name
      _Item_linked.Child_item_category_ID
      _Item_linked.Child_item_category_label
      _Item_linked.Item_ID
      _Item_linked.Category_ID
      _Item_linked.Dictionary_ID

   ?   ?   ?   ?   ?   ?   ?   ?   ?

  stop_


save_

