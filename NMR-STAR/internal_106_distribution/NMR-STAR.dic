;
Items in the theoretical_cross_correlation_DD_list category provide information about a list of reported theoretical dipole-dipole cross correlation values.
;
   _Category.Mandatory_code             yes
   _Category.Loop_code                  no
   _Category.Category_group_ID          70
   _Category.Category_group_name        theoretical_dipole_dipole_cross_correlations
   _Category.Dictionary_ID              NMR-STAR

