     _Item_enumeration.Value
     _Item_enumeration.Detail
     _Item_enumeration.Item_ID
     _Item_enumeration.Category_ID
     _Item_enumeration.Dictionary_ID

  '_Atom_site.Ordered_flag'   1    'Flag indicating that the atom is in an ordered region of the structure.'      4892      341     NMR-STAR
  '_Atom_site.Ordered_flag'   0    'Flag indicating that the atom is in a poorly ordered region of the structure.'      4892      341     NMR-STAR

   stop_


