   _Category.Sf_category                category_description
   _Category.Sf_framecode               Sample_component
   _Category.ID                         101
   _Category.Name                      'Sample_component'
   _category.Description
;
Items in the sample_component category define the components of a sample, their concentration in the sample, and the isotopic labeling for the component.
;
   _Category.Mandatory_code             yes
   _Category.Loop_code                  yes
   _Category.Category_group_ID          14
   _Category.Category_group_name        sample
   _Category.Dictionary_ID              NMR-STAR

   loop_
     _Category_primary_key.Item_ID
     _Category_primary_key.Item_label
     _Category_primary_key.Item_name
     _Category_primary_key.Category_ID
     _Category_primary_key.Dictionary_ID

    1274   '$_Sample_component.ID'     '_Sample_component.ID'    101   NMR-STAR
    1292   '$_Sample_component.Entry_ID'     '_Sample_component.Entry_ID'    101   NMR-STAR
    1293   '$_Sample_component.Sample_ID'     '_Sample_component.Sample_ID'    101   NMR-STAR

   stop_

save_

