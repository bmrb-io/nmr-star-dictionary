  '_Distance_constraint_list.Constraint_type'   NOE    'Distance constraints determined from NOE experiments'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'NOE build-up'    'Distance constraints determined from a series of NOE experiments with different mixing times'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'NOE not seen'    'Distance constraints supplied when an expected NOE was not observed'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   ROE    'Distance constraints determined from ROE experiments'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'ROE build-up'    'Distance constraints determine from a series of ROE experiments with different mixing times'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'hydrogen bond'    'Hydrogen bond distance constraints'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'disulfide bond'    'Disulfide bond distance constraints'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'paramagnetic relaxation'    'Distance constraints determined from paramagnetic relaxation studies'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   symmetry    'Distance constraint enforces symmetry - for example to enforce symmetry between monomers in a multimer'      5721      390     NMR-STAR
  '_Distance_constraint_list.Constraint_type'   'general distance'    'Specific distance constraint is not known'      5721      390     NMR-STAR

