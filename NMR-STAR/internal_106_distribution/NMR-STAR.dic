save__Entity_assembly.Physical_state
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Entity_assembly.Physical_state'
   _Item.ID                      414
   _Item.Name                   '_Entity_assembly.Physical_state'
   _Item.Description
;
An enumerated list of descriptive terms used to define the conformational 
state of the component of the assembly.
;

   _Item.Category_ID                            33
   _Item.Category_label                        '$Entity_assembly'
   _Item.Mandatory_code                         no
   _Item.Type_code                             'line'
   _Item.Default_value                         '?'
   _Item.Enumerated_code                        yes
   _Item.Enumeration_closed_code                no

   loop_
     _Item_enumeration.Item_name
     _Item_enumeration.Value
     _Item_enumeration.Detail
     _Item_enumeration.Item_ID
     _Item_enumeration.Category_ID
     _Item_enumeration.Dictionary_ID

  '_Entity_assembly.Physical_state'   native    'The entity in the assembly is in a biologically native state usually in a folded conformation'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   denatured    'The entity in the assembly is in a non-native state usually caused by the addition of denaturing agents like urea or guanidine hydrochloride'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   'molten globule'    'A state somewhere between a native folded state and an unfolded state caused by environmental effects like pH or temperature'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   unfolded    'The entity in the assembly is in a state where little or no secondary structure exists but is not an IDP/IDR'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   'intrinsically disordered'    'The entity in the assembly is considered an intrinsically disorder biopolymer (IDP) where the native state involves little organized secondary structure'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   'partially disordered'    'The entity in the assembly contains regions of disordered structure (IDR) but is not fully unfolded or fully disordered'      414      33     NMR-STAR
  '_Entity_assembly.Physical_state'   na    'The physical state of the entity in the assembly is an unknown physical state or may be in exchange between different physical states'      414      33     NMR-STAR

   stop_


