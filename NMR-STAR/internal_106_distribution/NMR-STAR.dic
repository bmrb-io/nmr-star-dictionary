save_Spectral_transition
   _Category.Sf_category                category_description
   _Category.Sf_framecode               Spectral_transition
   _Category.ID                         191
   _Category.Name                      'Spectral_transition'
   _category.Description
;
Items in the spectral_transition category assign a unique identifier to a spectral transition and define the link between the spectral transition and a spectral peak. An example of a spectral transition would be one of the transitions observed in a spectral doublet resulting from scalar coupling.
;
   _Category.Mandatory_code             yes
   _Category.Loop_code                  yes
   _Category.Category_group_ID          44
   _Category.Category_group_name        spectral_peak_list
   _Category.Dictionary_ID              NMR-STAR

   loop_
     _Category_primary_key.Item_ID
     _Category_primary_key.Item_label
     _Category_primary_key.Item_name
     _Category_primary_key.Category_ID
     _Category_primary_key.Dictionary_ID

    2648   '$_Spectral_transition.ID'     '_Spectral_transition.ID'    191   NMR-STAR
    2653   '$_Spectral_transition.Entry_ID'     '_Spectral_transition.Entry_ID'    191   NMR-STAR
    2654   '$_Spectral_transition.Spectral_peak_list_ID'     '_Spectral_transition.Spectral_peak_list_ID'    191   NMR-STAR

   stop_

save_

save__Spectral_transition.ID
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Spectral_transition.ID'
   _Item.ID                      2648
   _Item.Name                   '_Spectral_transition.ID'
   _Item.Description
;
Unique identifier for the spectral peak.
;

   _Item.Category_ID                            191
   _Item.Category_label                        '$Spectral_transition'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'int'

  loop_
      _Item_linked.Item_name
      _Item_linked.Child_item_ID
      _Item_linked.Child_item_label
      _Item_linked.Child_item_name
      _Item_linked.Child_item_category_ID
      _Item_linked.Child_item_category_label
      _Item_linked.Item_ID
      _Item_linked.Category_ID
      _Item_linked.Dictionary_ID

   ?   ?   ?   ?   ?   ?   ?   ?   ?

  stop_


save_

