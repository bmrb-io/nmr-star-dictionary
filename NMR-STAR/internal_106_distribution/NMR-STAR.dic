Pointer to '_Entry.ID'
;

   _Item.Category_ID                            1
   _Item.Category_label                        '$Entry_interview'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'code'


save_

save__Entry_interview.Sf_ID
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Entry_interview.Sf_ID'
   _Item.ID                      4
   _Item.Name                   '_Entry_interview.Sf_ID'
   _Item.Description
;
An interger value that is the unique identifier for the save frame that 
applies across the archive.  This value is not stable and may be reassigned each 
time the data are loaded into a database system.
;

   _Item.Category_ID                            1
   _Item.Category_label                        '$Entry_interview'
   _Item.Mandatory_code                         yes
   _Item.Type_code                             'int'


save_

