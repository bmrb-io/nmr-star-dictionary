   _Item.Sf_framecode           '_Experiment.NUS_flag'
   _Item.ID                      1622
   _Item.Name                   '_Experiment.NUS_flag'
   _Item.Description
;
The value for this tag is a flag to indicate 'yes' or 'no' if non-uniform 
sampling of spectral data points was used in collecting the data for the experiment.
;

   _Item.Category_ID                            140
   _Item.Category_label                        '$Experiment'
   _Item.Mandatory_code                         no
   _Item.Type_code                             'yes_no'


