save__Entry_interview.PDB_deposition
   _Item.Sf_category             item_description
   _Item.Sf_framecode           '_Entry_interview.PDB_deposition'
   _Item.ID                      6
   _Item.Name                   '_Entry_interview.PDB_deposition'
   _Item.Description
