# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Text files are stored and checked out LF-terminated on every platform.
# (Note: git only normalizes CRLF; the bare-CR Excel exports had to be
# converted on disk by hand.)
*.csv text eol=lf
*.txt text eol=lf
*.dic text eol=lf
*.str text eol=lf
*.cif text eol=lf

# Denote all files that are truly binary and should not be modified.
*.xls binary
